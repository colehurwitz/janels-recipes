---
layout: base.njk
pagination:
  data: categories
  size: 1
  alias: category
permalink: "/categories/{{ category | categorySlug }}/"
eleventyComputed:
  title: "{{ category }}"
---
{# One page per fixed category, generated by paginating the `categories` global
   data list. Recipes come from the single `recipesByCategory` collection rule —
   adding a recipe never touches this template. #}
{% set recipes = collections.recipesByCategory[category] %}
<section class="category-page">
  <header class="category-header">
    <p class="eyebrow">Category</p>
    <h1>{{ category }}</h1>
    <p class="category-count">{{ recipes | length }} recipe{% if (recipes | length) != 1 %}s{% endif %}</p>
  </header>

  {% if recipes | length %}
    <ul class="recipe-list">
      {% for recipe in recipes %}
        <li>
          <a class="recipe-link" href="{{ recipe.url | url }}">
            <span class="recipe-link-title">{{ recipe.data.title }}</span>
            {% if recipe.data.image %}<span class="recipe-link-badge" aria-label="has a photo">📷</span>{% endif %}
          </a>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p class="empty-note">No recipes here yet — they'll appear automatically once one is added with <code>category: {{ category }}</code>.</p>
  {% endif %}
</section>
