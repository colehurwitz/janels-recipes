---
layout: base.njk
---
{# Recipe page. `data-pagefind-body` marks this article as the searchable unit;
   the chrome in base.njk is `data-pagefind-ignore`d. Optional fields (image,
   notes) render only when present — forgiving frontmatter, no hard-fail. #}
<article class="recipe" data-pagefind-body>
  <div class="recipe-actions" data-pagefind-ignore>
    <a class="back-link" href="{{ ('/categories/' + (category | categorySlug) + '/') | url }}">← {{ category }}</a>
    <button type="button" class="print-btn" onclick="window.print()">🖨 Print this recipe</button>
  </div>

  <h1 class="recipe-title">{{ title }}</h1>
  {% if category %}
    <p class="recipe-category" data-pagefind-filter="category">{{ category }}</p>
  {% endif %}

  {% if image %}
    <img class="recipe-hero" src="{{ ('/images/' + image) | url }}" alt="{{ title }}" />
  {% endif %}

  <div class="recipe-content">
    {{ content | safe }}
  </div>

  {% if notes %}
    <aside class="recipe-notes">
      <h2>Notes</h2>
      <p>{{ notes }}</p>
    </aside>
  {% endif %}
</article>

{# schema.org Recipe structured data (SEO). Built ENTIRELY from existing
   frontmatter — no new required field, so the auto-discovery contract holds.
   Values go through `| dump` (JSON.stringify) so quotes/newlines are escaped,
   then `| safe` so Nunjucks doesn't HTML-escape the JSON. Absolute URLs use
   site.url + the RAW page.url: site.url already carries the /janels-recipes
   path prefix, and page.url is pre-prefix, so they compose to exactly one
   prefix (the `| url` filter would re-add it and double it). Optional fields
   (recipeCategory, image) carry their own leading comma so the JSON stays
   valid whether or not they render. #}
<script type="application/ld+json" data-pagefind-ignore>
{
  "@context": "https://schema.org",
  "@type": "Recipe",
  "name": {{ title | dump | safe }},
  "author": { "@type": "Organization", "name": {{ site.title | dump | safe }} },
  "description": {{ (notes if notes else site.description) | dump | safe }},
  "url": {{ (site.url + page.url) | dump | safe }},
  "mainEntityOfPage": {{ (site.url + page.url) | dump | safe }}{% if category %},
  "recipeCategory": {{ category | dump | safe }}{% endif %}{% if image %},
  "image": {{ (site.url + "/images/" + image) | dump | safe }}{% endif %}
}
</script>
